<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
    <Verify_GitHubSponsorAccount>wcomab</Verify_GitHubSponsorAccount>
    <Verify_SponsorshipStart>2026-09-13</Verify_SponsorshipStart>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Cake.Bridge.DependencyInjection.Testing" Version="2026.10.26.892" />
    <PackageVersion Include="Cake.Bridge.DependencyInjection" Version="2026.10.26.892" />
    <PackageVersion Include="Cake.Common" Version="6.3.0" />
    <PackageVersion Include="Cake.Testing" Version="6.3.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Devlead.Console" Version="2026.10.26.1021" />
    <PackageVersion Include="Devlead.Testing.MockHttp" Version="2026.10.26.1076" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" Condition="'$(TargetFramework)' != 'net11.0'" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0-rc.3.26522.148" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageVersion Include="System.Linq.Async" Version="7.0.1" Condition="'$(TargetFramework)' != 'net11.0'" />
    <PackageVersion Include="Verify.MicrosoftLogging" Version="5.0.0" />
    <PackageVersion Include="Verify.XunitV3" Version="33.3.4" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>